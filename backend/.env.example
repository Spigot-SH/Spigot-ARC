# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4402
NODE_ENV=development
# Local SQLite file. On Railway, point this at the mounted volume: /app/data/x402.db
DATABASE_PATH=./data/x402.db
GATEWAY_BASE_URL=http://localhost:4402
APP_BASE_URL=http://localhost:5173
# How long a 402 challenge stays valid
PAYMENT_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Arc Network — Primary Default L1 (Circle Arc Testnet)
# ---------------------------------------------------------------------------
# Arc features native USDC gas and 0-opt-in accounts.
ARC_CHAIN_ID=5042002
ARC_NETWORK=eip155:5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_EXPLORER_URL=https://testnet.arcscan.app

# Arc Treasury 3-account keys (hex private keys without 0x prefix or with 0x)
ARC_TREASURY_PRIVATE_KEY=
ARC_SETTLEMENT_PRIVATE_KEY=
ARC_CUSTODY_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Nanopayments (EIP-3009 TransferWithAuthorization)
# ---------------------------------------------------------------------------
NANOPAYMENT_MAX_BATCH_SIZE=50
NANOPAYMENT_BATCH_TIMEOUT_MS=60000
NANOPAYMENT_GATEWAY_URL=http://localhost:4402

# ---------------------------------------------------------------------------
# Algorand network — Secondary / Multi-chain
# ---------------------------------------------------------------------------
# testnet | mainnet. Setting this derives the CAIP-2 network, USDC ASA, algod,
# indexer and explorer URLs. See MAINNET.md before switching.
ALGORAND_NETWORK_PROFILE=testnet

# Optional per-value overrides. Leave blank to follow the profile above.
#   testnet -> algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=  USDC 10458941
#   mainnet -> algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=  USDC 31566704
ALGORAND_NETWORK=
USDC_ASA_ID=
ALGORAND_NODE_URL=
ALGORAND_INDEXER_URL=
EXPLORER_BASE_URL=
ALGORAND_NODE_TOKEN=

# ---------------------------------------------------------------------------
# x402 facilitator (GoPlausible) — signs and pays the ALGO fee for every payment
# ---------------------------------------------------------------------------
FACILITATOR_URL=https://facilitator.goplausible.xyz

# ---------------------------------------------------------------------------
# EVM chains
# ---------------------------------------------------------------------------
# Chain ids, USDC addresses, RPCs and explorers all follow ALGORAND_NETWORK_PROFILE.
# Leave EVM_ENABLED_CHAINS blank to take the profile default:
#   testnet -> ethereum,base,arbitrum,optimism,avalanche,robinhood   (Sepolia/Fuji)
#   mainnet -> ethereum,base,arbitrum,optimism,avalanche
# `robinhood` has no mainnet entry: its constants are unverified, so enabling it on
# mainnet requires supplying them through EVM_CHAIN_OVERRIDES_JSON below. An enabled
# chain with no definition fails at boot rather than silently disappearing.
EVM_FACILITATOR_URL=https://facilitator.x402.rs
EVM_ENABLED_CHAINS=
# Per-chain escape hatch for a private RPC, or for constants not in the built-in table:
#   EVM_CHAIN_OVERRIDES_JSON={"base":{"rpcUrl":"https://my-node.example"}}
EVM_CHAIN_OVERRIDES_JSON=
# EVM settlement wallet — address and private key for EVM custody payments
EVM_SETTLEMENT_ADDRESS=
EVM_SETTLEMENT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Solana (SVM) multi-chain support
# ---------------------------------------------------------------------------
# Cluster, USDC mint and RPC follow ALGORAND_NETWORK_PROFILE:
#   testnet -> devnet,       USDC 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
#   mainnet -> mainnet-beta, USDC EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_FACILITATOR_URL=https://facilitator.x402.rs
SOLANA_ENABLED_CHAINS=solana
SOLANA_SETTLEMENT_ADDRESS=
SOLANA_SETTLEMENT_PRIVATE_KEY=
TREASURY_MNEMONIC_SOLANA=
# Leave blank to follow the profile. Set for a private RPC.
SOLANA_RPC_URL=

STELLAR_FACILITATOR_URL=https://facilitator.x402.rs
STELLAR_ENABLED_CHAINS=stellar
STELLAR_SETTLEMENT_ADDRESS=
STELLAR_SETTLEMENT_SECRET=
TREASURY_SECRET_STELLAR=
TREASURY_MNEMONIC_STELLAR=
# Leave blank to follow the profile. Set for a private RPC / Horizon.
STELLAR_RPC_URL=
STELLAR_HORIZON_URL=

# ---------------------------------------------------------------------------
# Treasury
# ---------------------------------------------------------------------------
# Two accounts, kept separate on purpose so that money owed to vendors is never
# spent on running the platform.
#
# OPERATIONS — pays the ALGO that activates user wallets, and receives that ALGO back
# when a wallet is closed, plus withdrawal fees. Needs testnet ALGO. This is your cost
# of doing business; it should never hold vendor revenue.
#
# SOLANA OPERATIONS — holds testnet SOL and USDC to fund user Solana custodial wallets
# and settlements on Solana Devnet.
TREASURY_MNEMONIC=
#
# EVM OPERATIONS — holds testnet ETH and USDC to fund user EVM custodial wallets
# on top-ups across supported EVM networks.
TREASURY_MNEMONIC_EVM=
#
# SETTLEMENT — the x402 payTo. Every API payment lands here and every vendor payout
# comes out of here. Needs a little ALGO for fees plus the USDC float.
# If left blank it falls back to TREASURY_MNEMONIC and the server warns at boot that
# the two pots are commingled.
SETTLEMENT_MNEMONIC=
#
# CUSTODY — holds USDC deposited by users, which is their unspent credit balance, and is
# the payer for every on-chain API call. Users have no wallet of their own, so this single
# opted-in account replaces one account per user. Keep it apart from settlement so money
# held FOR users is never confused with money the platform has EARNED.
CUSTODY_MNEMONIC=
# Overrides the payTo address. Leave blank to use the settlement account.
PLATFORM_WALLET_ADDRESS=

# ---------------------------------------------------------------------------
# Credits — users buy a balance and spend it per API call
# ---------------------------------------------------------------------------
# Bounds for a custom top-up. Fixed tiers ($5/$20/$50) are defined in code.
MIN_RECHARGE_USDC=1
MAX_RECHARGE_USDC=1000
# The user is credited the full tier even if fees mean slightly less arrives.
RECHARGE_TOLERANCE_USDC=0.25
# HMAC secret for the fiat onramp webhook. Required before enabling fiat top-ups.
ONRAMP_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=5
# Spent per ACTIVATED wallet: 0.1 ALGO ASA minimum balance + opt-in fee headroom.
# Nothing is spent at sign-up — a user must activate before any ALGO leaves the treasury,
# so mass registration cannot drain it. The ALGO comes back when they withdraw in full.
WALLET_FUNDING_MICROALGOS=201000

# Free USDC handed out on activation. Keep at 0 — users fund themselves.
# Only raise it on a throwaway testnet where giving away balance is the point.
SIGNUP_USDC_GRANT=0

# Charged on a PARTIAL withdrawal to recover the activation ALGO. A full withdrawal
# closes the wallet and returns that ALGO automatically, so it is free.
WITHDRAWAL_FEE_USDC=0.1
# Smallest withdrawal accepted, so a payout never costs more than it moves.
MIN_WITHDRAWAL_USDC=0.2

# ---------------------------------------------------------------------------
# Secrets — generate with: openssl rand -hex 32
# Required in production. Generated and cached under data/ in development.
# ---------------------------------------------------------------------------
SESSION_SECRET=
# Encrypts custodial wallet keys at rest. Changing it makes existing wallets unreadable.
MASTER_ENCRYPTION_KEY=
SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Google Identity Services client ID (also set VITE_GOOGLE_CLIENT_ID for the frontend)
GOOGLE_CLIENT_ID=
MAGIC_LINK_TTL_MINUTES=15
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Email — without a key, magic links and OTP codes print to the server console
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Spigot <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Optional Turso replication — leave blank to run purely on local SQLite
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Skips DNS TXT proof of domain ownership. Development only — ignored when
# NODE_ENV=production, where publishers must add the TXT record shown by /verify/initiate.
DOMAIN_VERIFY_BYPASS=true

# ---------------------------------------------------------------------------
# Bazaar discovery & Global x402 Challenge attribution
# ---------------------------------------------------------------------------
# Attached to every payment requirement so the competition can attribute activity.
X402_CHALLENGE_TAG=x402-global-challenge
# Merchant card in the Bazaar catalog, grouped by your payTo address.
MERCHANT_NAME=Spigot
MERCHANT_WEBSITE=
MERCHANT_LOGO=
MERCHANT_CATEGORIES=api,gateway,algorand,x402

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Guards /admin/status (treasury addresses, balances, liabilities).
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
