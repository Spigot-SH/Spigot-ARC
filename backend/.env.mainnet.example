# ---------------------------------------------------------------------------
# MAINNET profile — real funds move on this network.
#
#   cp backend/.env.mainnet.example backend/.env    then fill in every blank below.
#
# config.ts refuses to boot on mainnet if the treasury mnemonics are missing,
# if DOMAIN_VERIFY_BYPASS is on, or if any endpoint still points at a test
# network. That check is deliberate: fail at startup, not mid-payment.
# ---------------------------------------------------------------------------
ALGORAND_NETWORK_PROFILE=mainnet
NODE_ENV=production

PORT=4402
GATEWAY_BASE_URL=https://api.your-domain.example
APP_BASE_URL=https://your-domain.example
DATABASE_PATH=./data/x402.db

# REQUIRED. Two separate accounts on purpose: money owed to vendors must never
# be spent on running the platform.
#   OPERATIONS — pays the ALGO that activates user wallets.
#   SETTLEMENT — the x402 payTo; holds USDC owed to vendors.
TREASURY_MNEMONIC=
SETTLEMENT_MNEMONIC=
CUSTODY_MNEMONIC=

# REQUIRED on mainnet. Without it, sign-in links are printed to the console.
RESEND_API_KEY=
EMAIL_FROM=

# REQUIRED. Generate with: openssl rand -base64 32
SESSION_SECRET=
MASTER_ENCRYPTION_KEY=
ADMIN_TOKEN=
ONRAMP_WEBHOOK_SECRET=

# Fiat top-ups. Leave blank to keep the Razorpay routes returning 503.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# EVM and Solana settlement keys. Leave a chain out of EVM_ENABLED_CHAINS
# rather than running it with no key.
EVM_SETTLEMENT_ADDRESS=
EVM_SETTLEMENT_PRIVATE_KEY=
SOLANA_SETTLEMENT_ADDRESS=
SOLANA_SETTLEMENT_PRIVATE_KEY=

# `robinhood` has no verified mainnet definition and is excluded by default.
# Add it back only with EVM_CHAIN_OVERRIDES_JSON supplying real constants.
EVM_ENABLED_CHAINS=
EVM_CHAIN_OVERRIDES_JSON=

# Must stay off. The boot guard rejects it on mainnet.
DOMAIN_VERIFY_BYPASS=false
