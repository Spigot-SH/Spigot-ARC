# ---------------------------------------------------------------------------
# TESTNET profile — safe defaults for local development.
#
#   cp backend/.env.testnet.example backend/.env
#
# Everything network-shaped is derived from ALGORAND_NETWORK_PROFILE, so this
# file only sets the profile and the secrets you must supply yourself.
# See backend/.env.example for the full list of overridable keys.
# ---------------------------------------------------------------------------
ALGORAND_NETWORK_PROFILE=testnet
NODE_ENV=development

PORT=4402
GATEWAY_BASE_URL=http://localhost:4402
APP_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/x402.db

# Left blank on purpose: with no mnemonic the backend generates a throwaway
# development account and persists it to data/dev_keys.json. Never do this on
# mainnet, where the boot guard refuses to start without real values.
TREASURY_MNEMONIC=
SETTLEMENT_MNEMONIC=
CUSTODY_MNEMONIC=

# Blank means "print the email to the server console" rather than send it.
RESEND_API_KEY=

# Optional. Fiat top-ups are disabled when these are unset.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
